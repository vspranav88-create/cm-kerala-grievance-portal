# Root-level reference only. The applications read environment variables from
# backend/.env and frontend/.env separately. Do not put real secrets in this file.

# Backend (copy relevant values into backend/.env)
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Frontend (copy relevant value into frontend/.env)
VITE_API_URL=http://localhost:5000/api
